{
  "name": "Aposta",
  "type": "object",
  "properties": {
    "analise_id": {
      "type": "string",
      "description": "Refer\u00eancia \u00e0 an\u00e1lise que direcionou a aposta"
    },
    "evento": {
      "type": "string",
      "title": "Evento"
    },
    "mercado": {
      "type": "string"
    },
    "recomendacao": {
      "type": "string"
    },
    "odd": {
      "type": "number"
    },
    "valor": {
      "type": "number",
      "description": "Valor apostado"
    },
    "retorno_potencial": {
      "type": "number",
      "description": "valor * odd"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pendente",
        "Ganhou",
        "Perdeu",
        "Anulada"
      ],
      "default": "Pendente"
    },
    "data": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "evento",
    "recomendacao",
    "valor"
  ]
}